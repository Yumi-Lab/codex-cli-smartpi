#!/bin/sh
# codex-slot — bounded parallelism for codex on a 1 GB board.
#
#   codex-slot run -- <command> [args…]     acquire a slot, exec the command
#   codex-slot status [--json]              what is running / waiting right now
#
# Why this exists: nothing stopped a batch (the gateway, a cron, a loop) from
# starting ten agents at once. On 1 GB with SD-card swap, memory exhaustion
# freezes the whole machine before the kernel OOM killer reacts — the board does
# not come back on its own. This puts a hard ceiling on how many codex processes
# run at the same time, and makes the extra ones WAIT instead of failing.
#
# There is no daemon process: slots are `flock` locks on files, held by the codex
# process itself. Nothing to start, nothing to crash, nothing to leak — if a
# process dies, is killed or the board reboots, its lock is gone with it.
#
# Two gates, both must pass before a job starts:
#   1. a free slot among CODEX_MAX_PARALLEL (default 10)
#   2. enough free memory: CODEX_MIN_FREE_MB (default 180) still available
# The second is what makes the first honest — a ceiling above the freeze point
# protects nothing, and how much a codex turn actually costs depends on the
# engine, the model and the task.
#
#   CODEX_MAX_PARALLEL=0   disables the limiter entirely (not advised on 1 GB)
#   CODEX_SLOT_TIMEOUT=n   give up after n seconds of waiting (default 0 = never)
#   CODEX_SLOT_DIR=path    where the locks live (default /var/tmp/codex-slots)

set -u

MAX="${CODEX_MAX_PARALLEL:-10}"
MIN_FREE_MB="${CODEX_MIN_FREE_MB:-180}"
TIMEOUT="${CODEX_SLOT_TIMEOUT:-0}"

# System-wide by default: the gateway service user and a human on SSH must share
# the same ceiling, or the ceiling is not one. /var/tmp rather than /run — it is
# world-writable-with-sticky by convention, survives a reboot, and any user can
# create it. Stale files are harmless: the locks are advisory and die with the
# process holding them.
DIR="${CODEX_SLOT_DIR:-/var/tmp/codex-slots}"
mkdir -p "$DIR/waiting" 2>/dev/null || true
chmod 1777 "$DIR" "$DIR/waiting" 2>/dev/null || true

# A limiter that cannot write its slots must never take codex down with it: it
# steps aside and says so. (This is not theoretical — creating the directory as
# root at install time once made every unprivileged run die on a redirection.)
usable_dir() { [ -d "$DIR" ] && [ -w "$DIR" ] && [ -w "$DIR/waiting" ]; }

free_mb() {
  # MemAvailable is the honest number: free + reclaimable, what a new process can
  # actually take without pushing the board into swap.
  awk '/^MemAvailable:/ {print int($2/1024); found=1} END {if (!found) print 99999}' /proc/meminfo 2>/dev/null \
    || echo 99999
}

count_running() {
  n=0; i=1
  while [ "$i" -le "$MAX" ]; do
    # A slot whose lock cannot be taken non-blocking is held by a live process.
    # A slot file that does not exist yet counts as free, not as an error.
    if [ -e "$DIR/slot.$i" ] && ! flock -n "$DIR/slot.$i" true 2>/dev/null; then n=$((n + 1)); fi
    i=$((i + 1))
  done
  printf '%s' "$n"
}

count_waiting() {
  n=0
  for f in "$DIR"/waiting/*; do
    [ -e "$f" ] || continue
    pid="$(basename "$f")"
    if kill -0 "$pid" 2>/dev/null; then n=$((n + 1)); else rm -f "$f" 2>/dev/null; fi
  done
  printf '%s' "$n"
}

status() {
  running="$(count_running)"; waiting="$(count_waiting)"; avail="$(free_mb)"
  if [ "${1:-}" = "--json" ]; then
    printf '{"limiter":%s,"running":%s,"max":%s,"queued":%s,"available_mb":%s,"min_free_mb":%s}\n' \
      "$([ "$MAX" -gt 0 ] && echo true || echo false)" \
      "$running" "$MAX" "$waiting" "$avail" "$MIN_FREE_MB"
  else
    if [ "$MAX" -le 0 ]; then
      printf 'codex limiter: off (CODEX_MAX_PARALLEL=0)\n'
    else
      printf 'codex limiter: %s/%s running, %s waiting, %s MB available (floor %s MB)\n' \
        "$running" "$MAX" "$waiting" "$avail" "$MIN_FREE_MB"
    fi
  fi
  [ "$running" -gt 0 ] && return 0 || return 3
}

# Acquire a slot, then exec. The lock is held on fd 9 by the exec'd process, so
# it is released exactly when that process ends — no cleanup path to get wrong.
acquire_and_exec() {
  [ "$#" -gt 0 ] || { echo "codex-slot: nothing to run" >&2; exit 2; }
  if [ "$MAX" -le 0 ]; then exec "$@"; fi
  command -v flock >/dev/null 2>&1 || {
    echo "codex-slot: flock is missing (util-linux) — running without a limit" >&2
    exec "$@"
  }
  usable_dir || {
    echo "codex-slot: $DIR is not writable — running without a limit" >&2
    exec "$@"
  }

  marker="$DIR/waiting/$$"
  : > "$marker" 2>/dev/null || true
  # shellcheck disable=SC2064  # $marker must expand now, the trap outlives the loop
  trap "rm -f '$marker' 2>/dev/null" EXIT INT TERM

  waited=0; announced=0
  while :; do
    if [ "$(free_mb)" -ge "$MIN_FREE_MB" ]; then
      i=1
      while [ "$i" -le "$MAX" ]; do
        # Non-blocking: take the first free slot and keep fd 9 open across exec.
        # The `:` probe first — a failed `exec` redirection kills a POSIX shell.
        if : >>"$DIR/slot.$i" 2>/dev/null && exec 9>>"$DIR/slot.$i" && flock -n 9; then
          rm -f "$marker" 2>/dev/null
          trap - EXIT INT TERM
          exec "$@"
        fi
        i=$((i + 1))
      done
    fi

    if [ "$announced" -eq 0 ]; then
      printf '\033[1;33m[codex]\033[0m waiting for a slot (%s running, max %s, %s MB free) — Ctrl-C to give up\n' \
        "$(count_running)" "$MAX" "$(free_mb)" >&2
      announced=1
    fi
    sleep 2
    waited=$((waited + 2))
    if [ "$TIMEOUT" -gt 0 ] && [ "$waited" -ge "$TIMEOUT" ]; then
      echo "codex-slot: no slot after ${TIMEOUT}s — giving up" >&2
      exit 75   # EX_TEMPFAIL: try again later
    fi
  done
}

case "${1:-status}" in
  run)     shift; [ "${1:-}" = "--" ] && shift; acquire_and_exec "$@" ;;
  status)  shift 2>/dev/null || true; status "${1:-}" ;;
  *)       echo "usage: codex-slot run -- <command…> | codex-slot status [--json]" >&2; exit 2 ;;
esac
